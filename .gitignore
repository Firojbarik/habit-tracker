# Python virtual environment (regenerate anytime with: python -m venv venv)
backend/venv/
backend/__pycache__/
*.pyc

# SQLite database file (created by database.py — regenerate with the create-tables script)
backend/*.db

# Node dependencies (created in Phase 7 via npm install)
frontend/node_modules/

# Environment variables / secrets — never commit these
.env
backend/.env

# Editor settings (contains your local machine's file paths)
.vscode/

# OS-generated files
Thumbs.db
.DS_Store